def get_active_db():
    current = app_data.get("current_profile", "Default")
    return app_data["profiles"].get(current, app_data["profiles"]["Default"])

def get_engine(timeout=None):
    db = get_active_db()
    db_host = str(db.get('HOST', '')).replace('\\\\', '\\')
    if db.get("TYPE") == "Local File (SQLite)" or db_host.startswith("sqlite:///"):
        path = db_host.replace("sqlite:///", "")
        return create_engine(f"sqlite:///{path}")
    
    conn_str = f"mssql+pymssql://{db['USER']}:{db['PASS']}@{db_host}/{db['NAME']}"
    if timeout:
        return create_engine(conn_str, connect_args={'login_timeout': timeout})
    return create_engine(conn_str)

