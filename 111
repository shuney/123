# [수정] exe(onefile) 환경에서 재실행 시 발생하는 _MEI 임시 폴더 증발/충돌 완벽 해결
def toggle_theme(root):
    new_theme = "dark" if app_data.get("theme", "light") == "light" else "light"
    app_data["theme"] = new_theme
    try:
        app_data["win_x"] = root.winfo_x()
        app_data["win_y"] = root.winfo_y()
    except Exception:
        pass
    save_config()
    
    # ========================================================
    import subprocess
    env = os.environ.copy()
    
    # 1. 구버전 프로그램이 쓰던 찌꺼기 경로 기억을 완전히 삭제
    env.pop('TCL_LIBRARY', None)
    env.pop('TK_LIBRARY', None)
    env.pop('_MEIPASS2', None)
    
    # 2. 강제 덮어쓰기(execl) 대신, 새 창을 독립적으로 띄우고(Popen) 기존 창은 정상 종료
    subprocess.Popen([sys.executable] + sys.argv[1:], env=env)
    root.destroy()
    sys.exit(0)
    # ========================================================






