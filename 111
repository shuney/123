    if not file_path: return
    try: df = pd.read_excel(file_path, sheet_name=SHEET_MASTER, dtype=str).fillna("")
    except Exception as e: messagebox.showerror("Error", f"Failed to read Excel file:\n{e}"); return
    if df.empty: return
    import_data_logic(file_path, df, parent_window)

