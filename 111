    if with_browse:
        btn_browse = tk.Label(f_border, text="Browse...", font=(C_FONT, 9, "bold"), fg=C_ACCENT, bg=C_SEC_BG, cursor="hand2")
        btn_browse.pack(side="right", padx=10)
        btn_browse.bind("<Button-1>", lambda e: with_browse(ent))

    if is_pwd:
        ent.config(show="*")
        lbl_toggle = tk.Label(f_border, text="Show", font=(C_FONT, 8, "bold"), fg=C_ACCENT, bg=C_SEC_BG, cursor="hand2")
        lbl_toggle.pack(side="right", padx=10)
        
        def toggle_pwd_view(e):
            if ent.cget("show") == "*":
                ent.config(show=""); lbl_toggle.config(text="Hide")
            else:
                ent.config(show="*"); lbl_toggle.config(text="Show")
        lbl_toggle.bind("<Button-1>", toggle_pwd_view)
        
    return f_container, ent

