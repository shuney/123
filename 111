class ToolTip:
    def __init__(self, widget, text):
        self.widget = widget
        self.text = text
        self.tw = None
        self.widget.bind("<Enter>", self.enter)
        self.widget.bind("<Leave>", self.leave)

    def enter(self, event=None):
        x, y, cx, cy = self.widget.bbox("insert")
        x += self.widget.winfo_rootx() + 25
        y += self.widget.winfo_rooty() + 25
        self.tw = tk.Toplevel(self.widget)
        self.tw.wm_overrideredirect(True)
        self.tw.wm_geometry(f"+{x}+{y}")
        tk.Label(self.tw, text=self.text, justify='left', background="#333333", foreground="white", relief='solid', borderwidth=0, font=(C_FONT, 8)).pack(ipadx=5, ipady=3)

    def leave(self, event=None):
        if self.tw:
            self.tw.destroy()
            self.tw = None

class LoadingOverlay:
    def __init__(self, parent):
        self.parent = parent
        self.overlay = tk.Toplevel(parent)
        self.overlay.overrideredirect(True)
        self.overlay.attributes("-alpha", 0.85)
        self.overlay.configure(bg="#000000")
        
        pw, ph = parent.winfo_width(), parent.winfo_height()
        px, py = parent.winfo_rootx(), parent.winfo_rooty()
        self.overlay.geometry(f"{pw}x{ph}+{px}+{py}")
        self.overlay.grab_set()

        self.canvas = tk.Canvas(self.overlay, width=100, height=100, bg="#000000", highlightthickness=0)
        self.canvas.place(relx=0.5, rely=0.45, anchor="center")
        self.text = tk.Label(self.overlay, text="Syncing Database...", font=(C_FONT, 10, "bold"), bg="#000000", fg="#FFFFFF")
        self.text.place(relx=0.5, rely=0.65, anchor="center")
        
        self.angle = 0
        self.running = True
        self.animate()

    def animate(self):
        if not self.running: return
        self.canvas.delete("spinner")
        self.angle = (self.angle + 20) % 360
        self.canvas.create_arc(10, 10, 90, 90, start=self.angle, extent=120, outline="#0071E3", width=5, style="arc", tags="spinner")
        self.canvas.create_arc(10, 10, 90, 90, start=self.angle+180, extent=120, outline="#66B2FF", width=5, style="arc", tags="spinner")
        self.parent.after(30, self.animate)

    def destroy(self):
        self.running = False
        self.overlay.grab_release()
        self.overlay.destroy()

