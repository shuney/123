def backup_database(engine):
    backup_dir = "backups"
    if not os.path.exists(backup_dir): os.makedirs(backup_dir)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_path = os.path.join(backup_dir, f"backup_db_{timestamp}.xlsx")
    
    with engine.connect() as conn:
        df_rsrc = pd.read_sql("SELECT * FROM rsrc", conn)
        df_rate = pd.read_sql("SELECT * FROM RSRCRATE", conn)
    
    with pd.ExcelWriter(backup_path) as writer:
        df_rsrc.to_excel(writer, sheet_name="rsrc_backup", index=False)
        df_rate.to_excel(writer, sheet_name="rate_backup", index=False)
    return backup_path

def import_data_logic(file_path, df, parent_window):
    engine = get_engine()
    
    try:
        with engine.connect() as conn:
            existing_rsrc = {}
            for r in conn.execute(text("SELECT rsrc_id, rsrc_short_name FROM rsrc")):
                sn = str(r[1]).strip().upper()
                existing_rsrc.setdefault(sn, []).append(r[0])
    except Exception as e:
        messagebox.showerror("Connection Error", "Failed to connect to the database.")
        return

    import copy
    sim_rsrc = copy.deepcopy(existing_rsrc)
    add_c, up_c, del_c = 0, 0, 0
    for idx, row in df.iterrows():
        sn = str(row.get("rsrc_short_name", "")).strip().upper()
        if not sn: continue
        is_del = str(row.get("Delete", "")).strip().lower() == "delete"
        exists = sn in sim_rsrc and len(sim_rsrc[sn]) > 0

        if is_del and exists:
            del_c += 1
            sim_rsrc[sn].pop(0) 
        elif not is_del and exists:
            up_c += 1
            sim_rsrc[sn].pop(0) 
        elif not is_del and not exists:
            add_c += 1
            sim_rsrc.setdefault(sn, []).append("temp_id") 

    if add_c == 0 and up_c == 0 and del_c == 0:
        messagebox.showinfo("Info", "No new data to update.")
        return

    msg = f"Synchronization preview:\n\n• Add: {add_c}\n• Update: {up_c}\n• Delete: {del_c}\n\nDo you want to proceed?"
    if not messagebox.askyesno("Dry Run", msg):
        return

    overlay = LoadingOverlay(parent_window)

    def run_sync():
        try:
            backup_database(engine)
            
            with engine.begin() as conn:
                existing_ids = set()
                for lst in existing_rsrc.values(): existing_ids.update(lst)
                
                try:
                    cal_info = {r[0]: float(r[1] or 8.0) for r in conn.execute(text("SELECT clndr_id, day_hr_cnt FROM CALENDAR"))}
                    default_cal_id = conn.execute(text("SELECT TOP 1 clndr_id FROM calendar WHERE default_flag='Y'")).scalar()
                except Exception: cal_info = {1: 8.0}; default_cal_id = 1
                    
                try: seq_num = (conn.execute(text("SELECT ISNULL(MAX(rsrc_seq_num), 0) FROM rsrc")).scalar() or 0) + 1
                except Exception: seq_num = 1
                try: rate_id_counter = (conn.execute(text("SELECT ISNULL(MAX(rsrc_rate_id), 0) FROM RSRCRATE")).scalar() or 0) + 1
                except Exception: rate_id_counter = 1

                path_to_id = {}
                try:
                    res = conn.execute(text("SELECT rsrc_id, parent_rsrc_id, rsrc_short_name FROM rsrc"))
                    rows = {r[0]: (r[1], str(r[2]).strip() if r[2] else "") for r in res}
                    def build_path(rid, visited=None):
                        if visited is None: visited = set()
                        if rid in visited: return ""
                        visited.add(rid)
                        pid, sname = rows.get(rid, (None, ""))
                        if pid and pid in rows: return f"{build_path(pid, visited)}{PATH_DELIM}{sname}" if build_path(pid, visited) else sname
                        return sname
                    
                    for rid in rows.keys(): 
                        full_path = build_path(rid)
                        if full_path: path_to_id[full_path.strip().upper()] = rid
                except Exception: pass

                success_cnt, update_cnt, delete_cnt = 0, 0, 0

                for idx, row in df.iterrows():
                    short_name_raw = str(row.get("rsrc_short_name", "")).strip()
                    if not short_name_raw: continue 
                    
                    lookup_short_name = short_name_raw.upper()
                    delete_flag = str(row.get("Delete", "")).strip().lower()
                    
                    target_id = None
                    if lookup_short_name in existing_rsrc and len(existing_rsrc[lookup_short_name]) > 0:
                        target_id = existing_rsrc[lookup_short_name][0]

                    if delete_flag == "delete":
                        if not target_id: continue 
                        try:
                            conn.execute(text("DELETE FROM RSRCRATE WHERE rsrc_id = :id"), {"id": target_id})
                            conn.execute(text("DELETE FROM rsrc WHERE rsrc_id = :id"), {"id": target_id})
                            delete_cnt += 1
                            existing_rsrc[lookup_short_name].pop(0)
                        except Exception: raise RuntimeError(f"[{short_name_raw}] Deletion failed. Check 'Used_In_Activities' column.")
                        continue

                    rsrc_name = str(row.get("rsrc_name", "")).strip()
                    rsrc_type = RSRC_TYPE_MAP.get(str(row.get("rsrc_type", "")).strip().lower(), "RT_Labor")
                    cal_id_raw = str(row.get("clndr_id (ID:Name)", "")).split(":")[0].strip()
                    clndr_id = int(float(cal_id_raw)) if cal_id_raw else default_cal_id
                    
                    units_raw = str(row.get("units_per_time", "")).strip()
                    day_hr_cnt = cal_info.get(clndr_id, DEFAULT_DAY_HR_CNT)
                    def_qty_per_hr = float(units_raw) / float(day_hr_cnt) if units_raw else 1.0

                    parent_id = None
                    raw_path = str(row.get("parent_path", "")).strip()
                    if raw_path:
                        parts = [p.strip() for p in raw_path.split(PATH_DELIM) if p.strip()]
                        running_path = ""
                        for segment in parts:
                            running_path = f"{running_path}{PATH_DELIM}{segment}" if running_path else segment
                            lookup_path = running_path.strip().upper()
                            lookup_seg = segment.strip().upper()
                            
                            if lookup_path in path_to_id: 
                                parent_id = path_to_id[lookup_path]
                            elif lookup_seg in existing_rsrc and len(existing_rsrc[lookup_seg]) > 0:
                                parent_id = existing_rsrc[lookup_seg][0]
                                path_to_id[lookup_path] = parent_id
                            else:
                                new_node_id = generate_unique_rsrc_id(existing_ids)
                                conn.execute(text("INSERT INTO rsrc (rsrc_id, parent_rsrc_id, clndr_id, rsrc_short_name, rsrc_name, rsrc_type, rsrc_seq_num, active_flag, def_qty_per_hr) VALUES (:id, :pid, :cid, :nm, :nm, 'RT_Labor', :seq, 'Y', 1.0)"), 
                                             {"id": new_node_id, "pid": parent_id, "cid": clndr_id, "nm": segment, "seq": seq_num})
                                seq_num += 1
                                
                                path_to_id[lookup_path] = new_node_id
                                existing_rsrc.setdefault(lookup_seg, []).append(new_node_id)
                                existing_ids.add(new_node_id)
                                parent_id = new_node_id

                    if target_id:
                        conn.execute(text("UPDATE rsrc SET rsrc_name=:nm, rsrc_type=:typ, clndr_id=:cid, parent_rsrc_id=:pid, def_qty_per_hr=:qty WHERE rsrc_id=:id"), 
                                     {"nm": rsrc_name, "typ": rsrc_type, "cid": clndr_id, "pid": parent_id, "qty": def_qty_per_hr, "id": target_id})
                        update_cnt += 1; rsrc_id_to_use = target_id
                        existing_rsrc[lookup_short_name].pop(0) 
                    else:
                        rsrc_id_to_use = generate_unique_rsrc_id(existing_ids)
                        conn.execute(text("INSERT INTO rsrc (rsrc_id, parent_rsrc_id, clndr_id, rsrc_short_name, rsrc_name, rsrc_type, rsrc_seq_num, active_flag, def_qty_per_hr) VALUES (:id, :pid, :cid, :snm, :nm, :typ, :seq, 'Y', :qty)"), 
                                     {"id": rsrc_id_to_use, "pid": parent_id, "cid": clndr_id, "snm": short_name_raw, "nm": rsrc_name, "typ": rsrc_type, "seq": seq_num, "qty": def_qty_per_hr})
                        seq_num += 1; success_cnt += 1
                        existing_ids.add(rsrc_id_to_use)

                    full_path_for_current = f"{raw_path}{PATH_DELIM}{short_name_raw}" if raw_path else short_name_raw
                    path_to_id[full_path_for_current.strip().upper()] = rsrc_id_to_use

                    cost_raw = str(row.get("cost_per_qty", "")).strip()
                    if cost_raw:
                        cost_val = float(cost_raw)
                        date_raw = str(row.get("rate_start_date", "")).strip()
                        start_dt = pd.to_datetime(date_raw).date() if date_raw else date(2025, 1, 1)
                        try:
                            rate_exists = conn.execute(text("SELECT rsrc_rate_id FROM RSRCRATE WHERE rsrc_id=:id AND start_date=:dt"), {"id": rsrc_id_to_use, "dt": start_dt}).scalar()
                            if rate_exists: conn.execute(text("UPDATE RSRCRATE SET cost_per_qty=:cst WHERE rsrc_rate_id=:rid"), {"cst": cost_val, "rid": rate_exists})
                            else:
                                conn.execute(text("INSERT INTO RSRCRATE (rsrc_rate_id, rsrc_id, start_date, cost_per_qty) VALUES (:rid, :id, :dt, :cst)"), {"rid": rate_id_counter, "id": rsrc_id_to_use, "dt": start_dt, "cst": cost_val})
                                rate_id_counter += 1
                        except Exception: pass

            parent_window.after(0, lambda: [overlay.destroy(), messagebox.showinfo("Success", "Database synchronization completed successfully.")])
        except Exception as e:
            err_str = traceback.format_exc()
            parent_window.after(0, lambda: [overlay.destroy(), messagebox.showerror("Error (Rollback)", f"Operation cancelled:\n\n{err_str}")])

    threading.Thread(target=run_sync, daemon=True).start()

def import_data(parent_window):
